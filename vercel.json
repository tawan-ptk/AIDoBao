{
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "{app/**,services/**,data/knowledge/**,data/catalog/**,data/rule_registry.json,data/source_manifest.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ]
}
