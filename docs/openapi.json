  "components": {
    "schemas": {
      "BatchRecords": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/Record"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Records"
          },
          "compact": {
            "type": "boolean",
            "title": "Compact",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "BatchRecords"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          },
          "scope": {
            "type": "string",
            "enum": [
              "auto",
              "my_data",
              "knowledge"
            ],
            "title": "Scope",
            "default": "auto"
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "Confirmation": {
        "properties": {
          "draft_id": {
            "type": "string",
            "title": "Draft Id"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "draft_id",
          "idempotency_key",
          "confirmed"
        ],
        "title": "Confirmation"
      },
      "Delete": {
        "properties": {
          "confirmation": {
            "type": "string",
            "title": "Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmation"
        ],
        "title": "Delete"
      },
      "DeleteRecordsRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "records",
              "all"
            ],
            "title": "Scope",
            "default": "records"
          },
          "record_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Record Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DeleteRecordsRequest"
      },
      "Extract": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "title": "Extract"
      },
      "FoodEnergyRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "food_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "raw",
                  "cooked",
                  "packaged",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Food State"
          },
          "components": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/MealComponent"
                },
                "type": "array",
                "maxItems": 30,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Components"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "FoodEnergyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JournalRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured At"
          },
          "use_model": {
            "type": "boolean",
            "title": "Use Model",
            "default": true
          },
          "compact": {
            "type": "boolean",
            "title": "Compact",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "JournalRequest"
      },
      "JournalTime": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "timezone": {
            "type": "string",
            "const": "Asia/Bangkok",
            "title": "Timezone",
            "default": "Asia/Bangkok"
          },
          "period": {
            "type": "string",
            "enum": [
              "unspecified",
              "morning",
              "noon",
              "afternoon",
