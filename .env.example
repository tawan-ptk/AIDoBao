SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never expose service-role credentials to the model/browser.
LOCAL_DB=data/local.sqlite3
MODEL_PATH=models/typhoon-4bit
# Store every health record in Supabase Postgres (private schema "ruamwan")
# instead of LOCAL_DB. Supabase → Connect → Direct connection (or Session pooler).
# Put the real value only in .env — never in chat, code or Git.
SUPABASE_DB_URL=

# Hosted AI model through OpenRouter (replaces the local fine-tuned model when set)
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=google/gemini-3.8-flash
# OPENROUTER_TASK_MODEL=google/gemini-3.8-flash
